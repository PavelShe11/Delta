CREATE TABLE HistoryEntry (
    id          INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    t           TEXT    NOT NULL,
    pStart      TEXT    NOT NULL,
    pEnd        TEXT    NOT NULL,
    pStartBar   TEXT    NOT NULL,
    pEndBar     TEXT    NOT NULL,
    tStartK     TEXT    NOT NULL,
    tEndK       TEXT    NOT NULL,
    result      REAL    NOT NULL,
    timestampMs INTEGER NOT NULL,
    tUnit       TEXT    NOT NULL DEFAULT '°C',
    pUnit       TEXT    NOT NULL DEFAULT 'МПа',
    name        TEXT,
    comment     TEXT
);

selectAll:
SELECT * FROM HistoryEntry ORDER BY timestampMs DESC;

insert:
INSERT INTO HistoryEntry (t, pStart, pEnd, pStartBar, pEndBar, tStartK, tEndK, result, timestampMs, tUnit, pUnit, name, comment)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteById:
DELETE FROM HistoryEntry WHERE id = ?;

deleteByIds:
DELETE FROM HistoryEntry WHERE id IN ?;

deleteAll:
DELETE FROM HistoryEntry;

count:
SELECT COUNT(*) FROM HistoryEntry;

lastInsertRowId:
SELECT last_insert_rowid();
